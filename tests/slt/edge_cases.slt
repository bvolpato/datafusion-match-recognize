# SPDX-License-Identifier: Apache-2.0
# SQL:2016 edge cases: UDAFs via Accumulator, CLASSIFIER() nav, PREV/NEXT in aggregates,
# 0-row tables, multi-column PARTITION BY, DESC NULLS FIRST, NULL in DEFINE, omitted MEASURES,
# and joined MATCH_RECOGNIZE relations.

# 1. Empty 0-row input table
statement ok
CREATE TABLE empty_tbl (p VARCHAR, id INT, v INT);

query TII
SELECT * FROM empty_tbl
MATCH_RECOGNIZE (
  PARTITION BY p
  ORDER BY id
  MEASURES MATCH_NUMBER() AS mn, COUNT(*) AS cnt
  ONE ROW PER MATCH
  PATTERN (a+)
  DEFINE a AS v > 0
);
----

# 2. Single-row partition + NULL in DEFINE (NULL evaluates to false)
statement ok
CREATE TABLE edge_rows (p1 VARCHAR, p2 INT, id INT, tag VARCHAR, v INT) AS VALUES
  ('x', 1, 1, 'A', 10),
  ('x', 2, 1, 'A', NULL),
  ('x', 2, 2, 'B', 20),
  ('y', 1, 3, 'A', 30),
  ('y', 1, 2, 'B', 25),
  ('y', 1, 1, 'B', 15),
  ('y', 1, 0, 'C', 5);

query TIIII
SELECT * FROM edge_rows
MATCH_RECOGNIZE (
  PARTITION BY p1, p2
  ORDER BY id DESC NULLS FIRST
  MEASURES
    MATCH_NUMBER() AS mn,
    FIRST(id) AS first_id,
    LAST(id) AS last_id
  ONE ROW PER MATCH
  PATTERN (a b* c?)
  DEFINE
    a AS v > 5,
    b AS tag = 'B',
    c AS tag = 'C'
)
ORDER BY p1, p2, mn;
----
x 1 1 1 1
x 2 1 2 2
y 1 1 3 0

# 3. Navigation over CLASSIFIER() + PREV/NEXT offsets (0 and out-of-bounds) + SUM(PREV(...))
statement ok
CREATE TABLE seq (id INT, tag VARCHAR, price INT) AS VALUES
  (1, 'A', 10),
  (2, 'B', 20),
  (3, 'B', 30),
  (4, 'C', 40);

query ITTTTTIIIIII
SELECT * FROM seq
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES
    MATCH_NUMBER() AS mn,
    FIRST(CLASSIFIER()) AS first_cls,
    LAST(CLASSIFIER()) AS last_cls,
    LAST(CLASSIFIER(), 1) AS prev_last_cls,
    PREV(CLASSIFIER(), 1) AS prev_cls,
    NEXT(CLASSIFIER(), 1) AS next_cls,
    PREV(a.price, 0) AS prev0_a,
    NEXT(c.price, 0) AS next0_c,
    FIRST(b.price, 100) AS oob_first,
    PREV(FIRST(a.price), 100) AS oob_prev,
    SUM(PREV(b.price)) AS sum_prev_b,
    SUM(NEXT(b.price)) AS sum_next_b
  ONE ROW PER MATCH
  PATTERN (a b+ c)
  DEFINE
    a AS tag = 'A',
    b AS tag = 'B',
    c AS tag = 'C'
);
----
1 A C B B NULL 10 40 NULL NULL 30 70

# 4. ALL ROWS PER MATCH with PREV(CLASSIFIER()) and NEXT(CLASSIFIER())
# Per SQL:2016 / Trino, NEXT(CLASSIFIER()) in MEASURES sees labels past current row within the completed match.
query ITTT
SELECT id, cls, p_cls, n_cls FROM seq
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES
    CLASSIFIER() AS cls,
    PREV(CLASSIFIER(), 1) AS p_cls,
    NEXT(CLASSIFIER(), 1) AS n_cls
  ALL ROWS PER MATCH
  PATTERN (a b+ c)
  DEFINE
    a AS tag = 'A',
    b AS tag = 'B',
    c AS tag = 'C'
)
ORDER BY id;
----
1 A NULL B
2 B A B
3 B B C
4 C B NULL

# 5. Arbitrary DataFusion AggregateUDFs inside MEASURES (ARRAY_AGG, STRING_AGG, STDDEV_SAMP, BOOL_AND)
query TTRB
SELECT * FROM seq
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES
    ARRAY_AGG(b.price) AS b_prices,
    STRING_AGG(tag, '-') AS path_str,
    ROUND(STDDEV_SAMP(price), 4) AS sd_price,
    BOOL_AND(price > 0) AS all_pos
  ONE ROW PER MATCH
  PATTERN (a b+ c)
  DEFINE
    a AS tag = 'A',
    b AS tag = 'B',
    c AS tag = 'C'
);
----
[20, 30] A-B-B-C 12.9099 true

# 6. Omitted MEASURES clause (ONE ROW outputs PARTITION BY only; ALL ROWS outputs input cols)
query T
SELECT * FROM edge_rows
MATCH_RECOGNIZE (
  PARTITION BY p1
  ORDER BY id
  ONE ROW PER MATCH
  PATTERN (a c)
  DEFINE
    a AS tag = 'A',
    c AS tag = 'C'
)
ORDER BY p1;
----

query TITIT
SELECT p1, id, p2, tag, v FROM edge_rows
MATCH_RECOGNIZE (
  PARTITION BY p1
  ORDER BY id
  ALL ROWS PER MATCH
  PATTERN (c b+ a)
  DEFINE
    c AS tag = 'C',
    b AS tag = 'B',
    a AS tag = 'A'
)
ORDER BY id;
----
y 0 1 C 5
y 1 1 B 15
y 2 1 B 25
y 3 1 A 30

# 7. Joining two MATCH_RECOGNIZE relations
query TII
WITH m1 AS (
  SELECT * FROM edge_rows
  MATCH_RECOGNIZE (
    PARTITION BY p1
    ORDER BY id
    MEASURES FIRST(id) AS s_id
    ONE ROW PER MATCH
    PATTERN (c b+ a)
    DEFINE c AS tag = 'C', b AS tag = 'B', a AS tag = 'A'
  )
),
m2 AS (
  SELECT * FROM edge_rows
  MATCH_RECOGNIZE (
    PARTITION BY p1
    ORDER BY id
    MEASURES LAST(id) AS e_id
    ONE ROW PER MATCH
    PATTERN (c b+ a)
    DEFINE c AS tag = 'C', b AS tag = 'B', a AS tag = 'A'
  )
)
SELECT m1.p1, m1.s_id, m2.e_id
FROM m1 JOIN m2 ON m1.p1 = m2.p1;
----
y 0 3
