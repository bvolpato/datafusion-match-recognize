# SPDX-License-Identifier: Apache-2.0
# Mined SQL:2016 MATCH_RECOGNIZE suite from Oracle Database (12c/19c/23ai Data Warehousing
# Guide, Pro Oracle SQL Ch. 19, Stew Ashton's RPR idioms), Apache Calcite (match.iq),
# Nexmark CEP (Q1/Q2), and deep DuckDB edge cases (timestamps, intervals, decimals, structs,
# table-alias qualifiers with CLASSIFIER(), CASE-inside-aggregates, DEFINE A AS NULL,
# CLASSIFIER() inside DEFINE, nested quantifiers, and multi-column ORDER BY ties).

# -----------------------------------------------------------------------------
# 1. Oracle Database classic patterns (W-shape, U-shape, fraud, sessionization,
#    gaps-and-islands, Pro Oracle SQL Ch. 19 decline streaks)
# -----------------------------------------------------------------------------

# Oracle W-shape over TIMESTAMP + DECIMAL(8,2) (two falls and two recoveries)
statement ok
CREATE TABLE ora_wide_tape (ticker VARCHAR, observed_at TIMESTAMP, quote DECIMAL(8, 2)) AS VALUES
  ('ZPHR', TIMESTAMP '2031-03-04 14:05:00', 60.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:06:00', 54.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:07:00', 48.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:08:00', 57.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:09:00', 63.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:10:00', 51.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:11:00', 44.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:12:00', 58.00),
  ('ZPHR', TIMESTAMP '2031-03-04 14:13:00', 66.00);

query TIII
SELECT ticker, CAST(EXTRACT(MINUTE FROM run_start) AS INT) AS s_min,
       CAST(EXTRACT(MINUTE FROM run_end) AS INT) AS e_min, shape_no
FROM ora_wide_tape
MATCH_RECOGNIZE (
  PARTITION BY ticker
  ORDER BY observed_at
  MEASURES
    FIRST(observed_at) AS run_start,
    LAST(observed_at) AS run_end,
    MATCH_NUMBER() AS shape_no
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (ANCHOR DROP_ONE+ RISE_ONE+ DROP_TWO+ RISE_TWO+)
  DEFINE
    DROP_ONE AS DROP_ONE.quote < PREV(DROP_ONE.quote),
    RISE_ONE AS RISE_ONE.quote > PREV(RISE_ONE.quote),
    DROP_TWO AS DROP_TWO.quote < PREV(DROP_TWO.quote),
    RISE_TWO AS RISE_TWO.quote > PREV(RISE_TWO.quote)
)
ORDER BY s_min;
----
ZPHR 5 13 1

# Oracle U-shape with FLAT* stretch at bottom + SKIP TO LAST UP
statement ok
CREATE TABLE ora_ushape (t INT, p INT) AS VALUES
  (1, 50), (2, 40), (3, 40), (4, 40), (5, 55), (6, 45), (7, 60);

query IIII
SELECT mn, s_t, e_t, flats FROM ora_ushape
MATCH_RECOGNIZE (
  ORDER BY t
  MEASURES
    MATCH_NUMBER() AS mn,
    FIRST(t) AS s_t,
    LAST(t) AS e_t,
    COUNT(FLAT.*) AS flats
  ONE ROW PER MATCH
  AFTER MATCH SKIP TO LAST UP
  PATTERN (STRT DOWN+ FLAT* UP+)
  DEFINE
    DOWN AS DOWN.p < PREV(DOWN.p),
    FLAT AS FLAT.p = PREV(FLAT.p),
    UP AS UP.p > PREV(UP.p)
)
ORDER BY mn;
----
1 1 5 2
2 5 7 0

# Oracle sessionization with TIMESTAMP + INTERVAL arithmetic in Tier 1b self-PREV
statement ok
CREATE TABLE ora_visits (visitor INT, hit_at TIMESTAMP) AS VALUES
  (7, TIMESTAMP '2031-03-04 08:05:00'),
  (7, TIMESTAMP '2031-03-04 08:22:00'),
  (7, TIMESTAMP '2031-03-04 09:40:00'),
  (7, TIMESTAMP '2031-03-04 09:47:00'),
  (7, TIMESTAMP '2031-03-04 11:00:00');

query III
SELECT visitor, session_no, hits FROM ora_visits
MATCH_RECOGNIZE (
  PARTITION BY visitor
  ORDER BY hit_at
  MEASURES
    MATCH_NUMBER() AS session_no,
    COUNT(*) AS hits
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (ANCHOR WITHIN_GAP*)
  DEFINE
    WITHIN_GAP AS WITHIN_GAP.hit_at <= PREV(WITHIN_GAP.hit_at) + INTERVAL '30' MINUTE
)
ORDER BY session_no;
----
7 1 2
7 2 2
7 3 1

# Oracle Data Warehousing Guide: Money-laundering / suspicious transfer detection
# (3+ small transfers < 2000 within 30 days totaling < 20000 followed within 10 days by large transfer >= 1000000)
statement ok
CREATE TABLE ora_transfers (user_id VARCHAR, tx_day INT, amount INT) AS VALUES
  ('u1', 1, 500), ('u1', 3, 700), ('u1', 5, 900), ('u1', 12, 1500000),
  ('u2', 1, 500), ('u2', 3, 700), ('u2', 5, 900), ('u2', 25, 1500000),
  ('u3', 1, 500), ('u3', 4, 500), ('u3', 8, 500), ('u3', 9, 500), ('u3', 15, 2000000);

query TIII
SELECT user_id, first_small, big_day, total_small FROM ora_transfers
MATCH_RECOGNIZE (
  PARTITION BY user_id
  ORDER BY tx_day
  MEASURES
    FIRST(X.tx_day) AS first_small,
    Y.tx_day AS big_day,
    SUM(X.amount) AS total_small
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (X{3,} Y)
  DEFINE
    X AS X.amount < 2000 AND X.tx_day - FIRST(X.tx_day) <= 30,
    Y AS Y.amount >= 1000000 AND Y.tx_day - LAST(X.tx_day) <= 10 AND SUM(X.amount) < 20000
)
ORDER BY user_id;
----
u1 1 12 2100
u3 1 15 2000

# Pro Oracle SQL Ch. 19: Years where launches decreased two or more consecutive years (PATTERN (DOWN DOWN+))
statement ok
CREATE TABLE ora_launches (yr INT, cnt INT) AS VALUES
  (2015, 50), (2016, 40), (2017, 30), (2018, 45), (2019, 40), (2020, 42), (2021, 35), (2022, 20), (2023, 10);

query II
SELECT decline_start, decline_end FROM ora_launches
MATCH_RECOGNIZE (
  ORDER BY yr
  MEASURES
    FIRST(DOWN.yr) AS decline_start,
    LAST(DOWN.yr) AS decline_end
  ONE ROW PER MATCH
  AFTER MATCH SKIP TO LAST DOWN
  PATTERN (DOWN DOWN+)
  DEFINE
    DOWN AS DOWN.cnt < PREV(DOWN.cnt)
)
ORDER BY decline_start;
----
2016 2017
2021 2023

# Oracle Gaps-and-Islands: find contiguous integer ranges
statement ok
CREATE TABLE ora_islands (n INT) AS VALUES (1), (2), (3), (7), (8), (12), (20), (21), (22), (23);

query III
SELECT island_start, island_end, island_len FROM ora_islands
MATCH_RECOGNIZE (
  ORDER BY n
  MEASURES
    FIRST(n) AS island_start,
    LAST(n) AS island_end,
    COUNT(*) AS island_len
  ONE ROW PER MATCH
  PATTERN (STRT CONT*)
  DEFINE CONT AS CONT.n = PREV(CONT.n) + 1
)
ORDER BY island_start;
----
1 3 3
7 8 2
12 12 1
20 23 4

# -----------------------------------------------------------------------------
# 2. Apache Calcite (match.iq) & Nexmark CEP (Q1/Q2)
# -----------------------------------------------------------------------------

# Calcite match.iq: String length budget in DEFINE with running SUM over concatenated expression
statement ok
CREATE TABLE calc_emp (deptno INT, empno INT, ename VARCHAR) AS VALUES
  (10, 7782, 'CLARK'), (10, 7839, 'KING'), (10, 7934, 'MILLER'),
  (20, 7369, 'SMITH'), (20, 7566, 'JONES'), (20, 7788, 'SCOTT'), (20, 7876, 'ADAMS'), (20, 7902, 'FORD');

query IIITT
SELECT deptno, empno, mno, cls, ename FROM calc_emp
MATCH_RECOGNIZE (
  PARTITION BY deptno
  ORDER BY empno
  MEASURES
    MATCH_NUMBER() AS mno,
    CLASSIFIER() AS cls
  ALL ROWS PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (S B+)
  DEFINE B AS CHAR_LENGTH(S.ename) + SUM(CHAR_LENGTH(B.ename || ';')) + CHAR_LENGTH(';') <= 15
)
ORDER BY deptno, empno;
----
10 7782 1 S CLARK
10 7839 1 B KING
20 7369 1 S SMITH
20 7566 1 B JONES
20 7788 2 S SCOTT
20 7876 2 B ADAMS

# Calcite [CALCITE-7734]: Pattern variable takes precedence over colliding table alias
statement ok
CREATE TABLE calc_alias (id INT, v INT) AS VALUES (1, 10), (2, 20), (3, 30);

query II
SELECT a_v, b_v FROM calc_alias AS a
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES a.v AS a_v, b.v AS b_v
  ONE ROW PER MATCH
  PATTERN (a b+)
  DEFINE a AS v = 10, b AS v > a.v
);
----
10 30

# Nexmark CEP Q1 & Q2: Longest period where running average price stays below threshold
statement ok
CREATE TABLE nex_bid (auction BIGINT, bidder BIGINT, ts INT, price INT) AS VALUES
  (1, 10, 1, 5000), (1, 10, 2, 12000), (1, 10, 3, 12000), (1, 10, 4, 20000),
  (1, 10, 5, 4000), (1, 10, 6, 15000);

query IIIIR
SELECT auction, bidder, start_ts, end_ts, avg_price FROM nex_bid
MATCH_RECOGNIZE (
  PARTITION BY auction, bidder
  ORDER BY ts
  MEASURES
    FIRST(A.ts) AS start_ts,
    LAST(A.ts) AS end_ts,
    AVG(A.price) AS avg_price
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ B)
  DEFINE A AS AVG(A.price) < 10000
)
ORDER BY start_ts;
----
1 10 1 3 9666.666666666666
1 10 5 5 4000.0

query IIIIR
SELECT auction, bidder, start_ts, end_ts, avg_price FROM nex_bid
MATCH_RECOGNIZE (
  PARTITION BY auction, bidder
  ORDER BY ts
  MEASURES
    FIRST(A.ts) AS start_ts,
    LAST(A.ts) AS end_ts,
    AVG(A.price) AS avg_price
  ONE ROW PER MATCH
  AFTER MATCH SKIP TO NEXT ROW
  PATTERN (A+ B)
  DEFINE A AS AVG(A.price) < 10000
)
ORDER BY start_ts;
----
1 10 1 3 9666.666666666666
1 10 5 5 4000.0

# -----------------------------------------------------------------------------
# 3. Deep DuckDB edge cases & regression tests for bugs fixed during audit
# -----------------------------------------------------------------------------

# Bug fix 1: DEFINE A AS NULL (DataType::Null predicate treated as false in both Tier 1 and Tier 2)
statement ok
CREATE TABLE edge_t (i INT, v INT) AS VALUES (1, 10), (2, 20), (3, 30);

query I
SELECT count(*) FROM edge_t
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES count(*) AS n
  PATTERN (A)
  DEFINE A AS NULL
);
----
0

query I
SELECT count(*) FROM edge_t
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES count(*) AS n
  PATTERN (A B)
  DEFINE A AS true, B AS CASE WHEN FIRST(A.v) > 0 THEN NULL ELSE NULL END
);
----
0

# Bug fix 2: Table-qualified column combined with CLASSIFIER() in aggregate (preserves table qualifier!)
query T
SELECT tags FROM edge_t AS t
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES string_agg(CAST(t.i AS VARCHAR) || ':' || CLASSIFIER(), ',') AS tags
  ONE ROW PER MATCH
  PATTERN (A B+)
  DEFINE A AS t.v = 10, B AS t.v > 10
);
----
1:A,2:B,3:B

# Table-qualified column inside FIRST(abs(t.v)) and MEASURES sum(CASE WHEN CLASSIFIER() = 'A' THEN t.v END)
query II
SELECT fa, sa FROM edge_t AS t
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES
    FIRST(abs(t.v)) AS fa,
    SUM(CASE WHEN CLASSIFIER() = 'A' THEN t.v END) AS sa
  ONE ROW PER MATCH
  PATTERN (A B+)
  DEFINE A AS t.v = 10, B AS t.v > 10
);
----
10 10

# Conditional COUNT(CASE WHEN B.v ... THEN 1 END) over variable-scoped rows (DuckDB session_model)
query III
SELECT total_b, b_hi, b_zero FROM edge_t
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES
    COUNT(B.i) AS total_b,
    COUNT(CASE WHEN B.v >= 30 THEN 1 END) AS b_hi,
    COUNT(CASE WHEN C.v > 0 THEN 1 END) AS b_zero
  ONE ROW PER MATCH
  PATTERN (A B+ C*)
  DEFINE A AS v = 10, B AS v > 10, C AS v > 100
);
----
2 1 0

# Bug fix 3: Struct field access with pattern variable qualifier (A.st.a, LAST(A.st.a), FIRST(A.st.b[1]))
statement ok
CREATE TABLE edge_struct AS
SELECT i, named_struct('a', i * 10, 'b', [i, i + 1]) AS st
FROM (VALUES (1), (2), (3)) t(i);

query III
SELECT first_a, last_b, first_arr1 FROM edge_struct
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES
    FIRST(A.st.a) AS first_a,
    LAST(B.st.a) AS last_b,
    FIRST(A.st.b[1]) AS first_arr1
  ONE ROW PER MATCH
  PATTERN (A B+)
  DEFINE A AS A.st.a = 10, B AS B.st.a > FIRST(A.st.a)
);
----
10 30 1

# CLASSIFIER() and LAST(CLASSIFIER()) inside DEFINE
query II
SELECT i, cl FROM edge_t
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES CLASSIFIER() AS cl
  ALL ROWS PER MATCH
  PATTERN (A B+)
  DEFINE
    A AS v = 10 AND CLASSIFIER() = 'A' AND LAST(CLASSIFIER()) = 'A',
    B AS v > 10 AND CLASSIFIER() = 'B'
)
ORDER BY i;
----
1 A
2 B
3 B

# Expression inside navigation in DEFINE: B AS v > FIRST(-A.v)
statement ok
CREATE TABLE edge_neg (i INT, v INT) AS VALUES (1, -5), (2, 3), (3, 10);

query II
SELECT n, s FROM edge_neg
MATCH_RECOGNIZE (
  ORDER BY i
  MEASURES count(*) AS n, FIRST(i) AS s
  ONE ROW PER MATCH
  PATTERN (A B+)
  DEFINE A AS true, B AS v > FIRST(-A.v)
);
----
2 2

# Compound PREV(LAST(B.price, 1), 1) in DEFINE (from test_match_recognize_navigation.test)
statement ok
CREATE TABLE edge_pstep (rn INT, price INT) AS VALUES
  (1, 10), (2, 20), (3, 30), (4, 40), (5, 50);

query IT
SELECT rn, c FROM edge_pstep
MATCH_RECOGNIZE (
  ORDER BY rn
  MEASURES CLASSIFIER() AS c
  ALL ROWS PER MATCH
  PATTERN (B{3} C)
  DEFINE B AS true, C AS PREV(LAST(B.price, 1), 1) = 10
)
ORDER BY rn;
----
1 B
2 B
3 B
4 C

# Nested nullable bounded quantifier: PATTERN ((((A | B)+)?){1,2}) (from test_match_recognize_backtracking_long.test)
statement ok
CREATE TABLE edge_shapes (g INT, seq INT, c VARCHAR) AS VALUES
  (1, 1, 'a'), (1, 2, 'a'), (1, 3, 'b'), (1, 4, 'a'), (1, 5, 'c'),
  (2, 1, 'b'), (2, 2, 'b'), (2, 3, 'b'),
  (3, 1, 'a');

query IIII
SELECT g, mno, first_seq, len FROM edge_shapes
MATCH_RECOGNIZE (
  PARTITION BY g
  ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, FIRST(seq) AS first_seq, COUNT(*) AS len
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN ((((A | B)+)?){1,2})
  DEFINE A AS c = 'a', B AS c = 'b'
)
ORDER BY g, mno;
----
1 1 1 4
1 2 NULL 0
2 1 1 3
3 1 1 1

# Exclusion + empty matches combined: SHOW EMPTY vs OMIT EMPTY on (({- A -})* B*)
statement ok
CREATE TABLE edge_six (x INT) AS VALUES (0), (1), (2), (3), (4), (5);

query I
SELECT x FROM edge_six
MATCH_RECOGNIZE (
  ORDER BY x
  ALL ROWS PER MATCH SHOW EMPTY MATCHES
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (({- A -})* B*)
  DEFINE A AS x % 3 = 0, B AS x % 3 = 1
)
ORDER BY x;
----
1
2
4
5

query I
SELECT x FROM edge_six
MATCH_RECOGNIZE (
  ORDER BY x
  ALL ROWS PER MATCH OMIT EMPTY MATCHES
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (({- A -})* B*)
  DEFINE A AS x % 3 = 0, B AS x % 3 = 1
)
ORDER BY x;
----
1
4

# Large bounded quantifier A{1,1000} over short partitions (from test_match_recognize_backtracking_long.test)
query III
SELECT g, mno, len FROM edge_shapes
MATCH_RECOGNIZE (
  PARTITION BY g
  ORDER BY seq
  MEASURES MATCH_NUMBER() AS mno, COUNT(*) AS len
  ONE ROW PER MATCH
  PATTERN (A{1,1000})
  DEFINE A AS 1 = 1
)
ORDER BY g, mno;
----
1 1 5
2 1 3
3 1 1

# CAST(1.0 / MATCH_NUMBER() AS INT) = 1 in DEFINE (exercises non-fast-path division in DEFINE)
query I
WITH t(x) AS (VALUES (1), (2))
SELECT count(*) FROM t
MATCH_RECOGNIZE (
  ORDER BY x
  MEASURES count(*) AS n
  PATTERN (A)
  DEFINE A AS CAST(1.0 / MATCH_NUMBER() AS INT) = 1
);
----
1
