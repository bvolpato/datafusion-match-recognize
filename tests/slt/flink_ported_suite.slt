# Ported from Apache Flink's MatchRecognizeITCase (batch & streaming SQL planner tests).

# 1. Flink testSimplePatternWithNulls: NULLs in DEFINE and LAST(B.nullField)
query ITIT
WITH my_table(id, name, null_field, ts) AS (
  VALUES
    (1, 'a', CAST(NULL AS VARCHAR), 1),
    (2, 'b', CAST(NULL AS VARCHAR), 2),
    (3, 'c', CAST(NULL AS VARCHAR), 3),
    (4, 'd', CAST(NULL AS VARCHAR), 4),
    (5, CAST(NULL AS VARCHAR), CAST(NULL AS VARCHAR), 5),
    (6, 'a', CAST(NULL AS VARCHAR), 6),
    (7, 'b', CAST(NULL AS VARCHAR), 7),
    (8, 'c', CAST(NULL AS VARCHAR), 8),
    (9, CAST(NULL AS VARCHAR), CAST(NULL AS VARCHAR), 9)
)
SELECT T.aid, T.b_null, T.cid, T.a_null FROM my_table
MATCH_RECOGNIZE (
  ORDER BY ts
  MEASURES
    A.id AS aid,
    A.null_field AS a_null,
    LAST(B.null_field) AS b_null,
    C.id AS cid
  PATTERN (A B C)
  DEFINE
    A AS name = 'a' AND null_field IS NULL,
    B AS name = 'b' AND LAST(A.null_field) IS NULL,
    C AS name = 'c'
) AS T
ORDER BY T.aid;
----
1 NULL 3 NULL
6 NULL 8 NULL

# 2. Flink testCodeSplitsAreProperlyGenerated: multi-key PARTITION BY + LIKE + out-of-range LAST(A.name, 2) IS NULL
query TTITIIT
WITH my_table(id, name, key1, key2, ts) AS (
  VALUES
    (1, 'a', 'key1', 'second_key3', 1),
    (2, 'b', 'key1', 'second_key3', 2),
    (3, 'c', 'key1', 'second_key3', 3),
    (4, 'd', 'key',  'second_key',  4),
    (5, 'e', 'key',  'second_key',  5),
    (6, 'a', 'key2', 'second_key4', 6),
    (7, 'b', 'key2', 'second_key4', 7),
    (8, 'c', 'key2', 'second_key4', 8),
    (9, 'f', 'key',  'second_key',  9)
)
SELECT * FROM my_table
MATCH_RECOGNIZE (
  PARTITION BY key1, key2
  ORDER BY ts
  MEASURES
    A.id AS aid,
    A.key1 AS akey1,
    LAST(B.id) AS bid,
    C.id AS cid,
    C.key2 AS ckey2
  PATTERN (A B C)
  DEFINE
    A AS name = 'a' AND key1 LIKE '%key%' AND id > 0,
    B AS name = 'b' AND LAST(A.name, 2) IS NULL,
    C AS name = 'c' AND LAST(A.name) = 'a'
) AS T
ORDER BY key1, key2;
----
key1 second_key3 1 key1 2 3 second_key3
key2 second_key4 6 key2 7 8 second_key4

# 3. Flink testEventsAreProperlyOrdered: 3-level ORDER BY (ts ASC, secondary DESC, ternary ASC)
query III
WITH my_table(ts, secondary_order, ternary_order, name, id) AS (
  VALUES
    (2, 12, 1, 'a', 1),
    (1, 11, 2, 'b', 2),
    (3, 10, 3, 'c', 3),
    (4,  8, 4, 'a', 4),
    (4,  9, 5, 'b', 5),
    (5,  7, 6, 'c', 6),
    (6,  6, 8, 'a', 7),
    (6,  6, 7, 'b', 8),
    (8,  4, 9, 'c', 9),
    (9,  3, 10, 'a', 10),
    (10, 2, 11, 'b', 11),
    (11, 1, 12, 'c', 12)
)
SELECT T.aid, T.bid, T.cid FROM my_table
MATCH_RECOGNIZE (
  ORDER BY ts, secondary_order DESC, ternary_order ASC
  MEASURES
    A.id AS aid,
    B.id AS bid,
    C.id AS cid
  PATTERN (A B C)
  DEFINE
    A AS name = 'a',
    B AS name = 'b',
    C AS name = 'c'
) AS T;
----
10 11 12

# 4. Flink testLogicalOffsets: LAST(DOWN.price, 1) IS NULL + FIRST(DOWN.price + DOWN.tax + 1)
# Note: SQL:2016 and Trino 484 properly backtrack out of greedy DOWN{2,} on row 3 so UP matches
# row 3 (13 < 19), producing both (1, 2, 3) and (6, 7, 8). Flink CEP omits (1, 2, 3) because it
# does not backtrack greedy loops.
query IIIII
WITH ticker(symbol, tstamp, price, tax) AS (
  VALUES
    ('ACME', 1, 19, 1),
    ('ACME', 2, 17, 2),
    ('ACME', 3, 13, 3),
    ('ACME', 4, 20, 4),
    ('ACME', 5, 20, 5),
    ('ACME', 6, 26, 6),
    ('ACME', 7, 20, 7),
    ('ACME', 8, 25, 8)
)
SELECT * FROM ticker
MATCH_RECOGNIZE (
  ORDER BY tstamp
  MEASURES
    FIRST(DOWN.tstamp) AS start_tstamp,
    LAST(DOWN.tstamp) AS bottom_tstamp,
    UP.tstamp AS end_tstamp,
    FIRST(DOWN.price + DOWN.tax + 1) AS bottom_total,
    UP.price + UP.tax AS end_total
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (DOWN{2,} UP)
  DEFINE
    DOWN AS price < LAST(DOWN.price, 1) OR LAST(DOWN.price, 1) IS NULL,
    UP AS price < FIRST(DOWN.price)
) AS T
ORDER BY start_tstamp;
----
1 2 3 21 16
6 7 8 33 33

# 5. Flink testLogicalOffsetsWithStarVariable: universal FIRST(id, 0..7) and LAST(id, 0..7)
query IIIIIIIIIIIIIIII
WITH ticker(id, symbol, tstamp, price) AS (
  VALUES
    (1, 'ACME', 1, 20),
    (2, 'ACME', 2, 19),
    (3, 'ACME', 3, 18),
    (4, 'ACME', 4, 17),
    (5, 'ACME', 5, 16),
    (6, 'ACME', 6, 15),
    (7, 'ACME', 7, 14),
    (8, 'ACME', 8, 20)
)
SELECT * FROM ticker
MATCH_RECOGNIZE (
  ORDER BY tstamp
  MEASURES
    FIRST(id, 0) AS id0,
    FIRST(id, 1) AS id1,
    FIRST(id, 2) AS id2,
    FIRST(id, 3) AS id3,
    FIRST(id, 4) AS id4,
    FIRST(id, 5) AS id5,
    FIRST(id, 6) AS id6,
    FIRST(id, 7) AS id7,
    LAST(id, 0) AS id8,
    LAST(id, 1) AS id9,
    LAST(id, 2) AS id10,
    LAST(id, 3) AS id11,
    LAST(id, 4) AS id12,
    LAST(id, 5) AS id13,
    LAST(id, 6) AS id14,
    LAST(id, 7) AS id15
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN ("DOWN_Q"{2,} UP)
  DEFINE
    "DOWN_Q" AS price < LAST(price, 1) OR LAST(price, 1) IS NULL,
    UP AS price = FIRST(price) AND price > FIRST(price, 3) AND price = LAST(price, 7)
) AS T;
----
1 2 3 4 5 6 7 8 8 7 6 5 4 3 2 1

# 6. Flink testLogicalOffsetOutsideOfRangeInMeasures
query III
WITH ticker(symbol, tstamp, price, tax) AS (
  VALUES
    ('ACME', 1, 19, 1),
    ('ACME', 2, 17, 2),
    ('ACME', 3, 13, 3),
    ('ACME', 4, 20, 4)
)
SELECT * FROM ticker
MATCH_RECOGNIZE (
  ORDER BY tstamp
  MEASURES
    FIRST(DOWN.price) AS first_p,
    LAST(DOWN.price) AS last_p,
    FIRST(DOWN.price, 5) AS null_price
  ONE ROW PER MATCH
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (DOWN{2,} UP)
  DEFINE
    DOWN AS price < LAST(DOWN.price, 1) OR LAST(DOWN.price, 1) IS NULL,
    UP AS price > LAST(DOWN.price)
) AS T;
----
19 13 NULL

# 7. Flink testAggregates: expressions in aggregates + greedy optional D? (matches SQL:2016 / Trino 484)
# Note: with D implicitly TRUE, SQL:2016 and Trino 484 greedily match D? on row 8 and E on row 9
# (producing a single match 1..9). Adding an explicit predicate for D verifies COUNT(D.price) = 0
# and SUM(D.price) = NULL when D is unmatched.
query IIIIRRI
WITH my_table(id, name, price, rate) AS (
  VALUES
    (1, 'a', 1, 0.8),
    (2, 'z', 2, 0.8),
    (3, 'b', 1, 0.8),
    (4, 'c', 1, 0.8),
    (5, 'd', 4, 0.1),
    (6, 'a', 2, 1.5),
    (7, 'b', 2, 0.8),
    (8, 'c', 1, 0.8),
    (9, 'h', 4, 0.8),
    (10, 'h', 4, 0.8),
    (11, 'h', 2, 0.8),
    (12, 'h', 2, 0.8)
)
SELECT * FROM my_table
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES
    FIRST(id) AS start_id,
    SUM(A.price) AS sum_a,
    COUNT(D.price) AS count_d,
    SUM(D.price) AS sum_d,
    AVG(B.price) AS avg_b,
    ROUND(SUM(B.price * B.rate), 4) AS sum_expr_b,
    LAST(id) AS end_id
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ B+ C D? E)
  DEFINE
    A AS SUM(A.price) < 6,
    B AS SUM(B.price * B.rate) < SUM(A.price)
      AND SUM(B.price * B.rate) > 0.2
      AND SUM(B.price) >= 1
      AND AVG(B.price) >= 1
) AS T
ORDER BY start_id;
----
1 5 1 1 3.0 3.4 9

query IIIIRRI
WITH my_table(id, name, price, rate) AS (
  VALUES
    (1, 'a', 1, 0.8),
    (2, 'z', 2, 0.8),
    (3, 'b', 1, 0.8),
    (4, 'c', 1, 0.8),
    (5, 'd', 4, 0.1),
    (6, 'a', 2, 1.5),
    (7, 'b', 2, 0.8),
    (8, 'c', 1, 0.8),
    (9, 'h', 4, 0.8),
    (10, 'h', 4, 0.8),
    (11, 'h', 2, 0.8),
    (12, 'h', 2, 0.8)
)
SELECT * FROM my_table
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES
    FIRST(id) AS start_id,
    SUM(A.price) AS sum_a,
    COUNT(D.price) AS count_d,
    SUM(D.price) AS sum_d,
    AVG(B.price) AS avg_b,
    ROUND(SUM(B.price * B.rate), 4) AS sum_expr_b,
    LAST(id) AS end_id
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ B+ C D? E)
  DEFINE
    A AS SUM(A.price) < 6,
    B AS SUM(B.price * B.rate) < SUM(A.price)
      AND SUM(B.price * B.rate) > 0.2
      AND SUM(B.price) >= 1
      AND AVG(B.price) >= 1,
    D AS name = 'never'
) AS T
ORDER BY start_id;
----
1 5 0 NULL 3.0 3.4 8
9 4 0 NULL 4.0 3.2 12

# 8. Flink testAggregatesWithNullInputs: COUNT(A.id) vs COUNT(A.price) vs COUNT(*) vs COUNT(price)
query IIIIII
WITH my_table(id, name, price) AS (
  VALUES
    (1, 'a', 10),
    (2, 'z', 10),
    (3, 'b', CAST(NULL AS INT)),
    (4, 'c', CAST(NULL AS INT)),
    (5, 'd', 3),
    (6, 'c', 3),
    (7, 'c', 3),
    (8, 'c', 3),
    (9, 'c', 2)
)
SELECT * FROM my_table
MATCH_RECOGNIZE (
  ORDER BY id
  MEASURES
    SUM(A.price) AS sum_a,
    COUNT(A.id) AS count_a_id,
    COUNT(A.price) AS count_a_price,
    COUNT(*) AS count_all,
    COUNT(price) AS count_all_price,
    LAST(id) AS end_id
  AFTER MATCH SKIP PAST LAST ROW
  PATTERN (A+ C)
  DEFINE
    A AS SUM(A.price) < 30,
    C AS C.name = 'c'
) AS T;
----
29 7 5 8 6 8

# 9. Flink FLINK-39293 + grouped input/output: MATCH_RECOGNIZE inside a CREATE VIEW and over grouped CTE
statement ok
CREATE TABLE flink_ticker (symbol VARCHAR, bucket INT, price INT) AS VALUES
  ('ACME', 0, 1),
  ('ACME', 0, 2),
  ('ACME', 1, 1),
  ('ACME', 1, 1),
  ('ACME', 2, 2),
  ('ACME', 2, 2);

statement ok
CREATE VIEW mr_bucket_drops AS
WITH grouped AS (
  SELECT symbol, bucket, SUM(price) AS total_price
  FROM flink_ticker
  GROUP BY symbol, bucket
)
SELECT * FROM grouped
MATCH_RECOGNIZE (
  PARTITION BY symbol
  ORDER BY bucket
  MEASURES
    B.total_price AS d_price,
    B.bucket AS d_bucket
  ONE ROW PER MATCH
  PATTERN (A B)
  DEFINE B AS B.total_price < A.total_price
);

query TII
SELECT * FROM mr_bucket_drops;
----
ACME 2 1
